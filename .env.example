# Native Node defaults. Local development runs on this machine only.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=.local/leonida.sqlite
DIST_DIR=dist
# Set explicitly to the external HTTPS origin when terminating TLS at a proxy.
PUBLIC_ORIGIN=
# Leave empty to disable Studio. Use a unique 32–512-character token.
ADMIN_TOKEN=
# Native Node only. Enable when one trusted proxy overwrites X-Real-IP and the
# application port accepts requests only from that proxy. Compose configures this.
TRUST_PROXY=0

# Empty in demo. The streaming overlay sets these for the included originals.
STREAM_BASE=
STREAM_RIGHTS_REFERENCE=
STREAM_HOSTS=
BROADCAST_STATUS_URL=

# Root Docker Compose. WEB_PORT is mapped on loopback in demo and development.
WEB_PORT=3000
SITE_DOMAIN=localhost
APP_DATA_VOLUME=leonida-fm-data
APP_IMAGE=leonida-fm:local
NODE_IMAGE=node:24-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54
CADDY_IMAGE=caddy:2.11.2-alpine@sha256:834468128c7696cec0ceea6172f7d692daf645ae51983ca76e39da54a97c570d
# Optional in combination with compose.admin.yml.
ADMIN_SECRET_PATH=./.local/secrets/admin-token

# Standalone broadcast Compose. Its local gateway stays on loopback.
BROADCAST_PORT=8088
DJ_ENABLED=0

# Optional personal-use yt-dlp adapter. LOCAL LOOPBACK ONLY. Not for public broadcast.
# On Windows, INICIAR_LEONIDA.bat installs yt-dlp.exe in tools/ and enables it if available.
ENABLE_LOCAL_YTDLP=0
# YTDLP_BIN=C:\\path\\to\\yt-dlp.exe
