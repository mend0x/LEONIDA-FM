{
  "name": "leonida-fm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env server/node.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint web server worker scripts tests --max-warnings 0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "node scripts/test-browser.mjs",
    "capture": "node scripts/test-browser.mjs --capture",
    "format:check": "prettier --check web server worker scripts/*.mjs",
    "catalog:sync": "node scripts/sync-tracks.mjs",
    "catalog:check": "node scripts/sync-tracks.mjs --check",
    "station:add": "node scripts/add-station.mjs",
    "directory:sync": "node scripts/sync-station-directory.mjs",
    "directory:check": "node scripts/sync-station-directory.mjs --check",
    "canciones:importar": "node scripts/importar-canciones.mjs",
    "canciones:estado": "node scripts/estado-canciones.mjs",
    "canciones:descargar": "node scripts/descargar-canciones.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.0.13"
  }
}
